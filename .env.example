# ==============================================================================
# ANUMATISETU — Smart India Hackathon 2026 (SIH26130)
# Production & Development Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Django Settings
# ------------------------------------------------------------------------------
# In production, generate a cryptographically strong 50+ character key.
# Example: python -c 'import secrets; print(secrets.token_urlsafe(50))'
SECRET_KEY=generate-a-strong-random-50-character-key-here

# Set to False in production. NEVER deploy with DEBUG=True.
DEBUG=False

# Comma-separated list of host/domain names that this Django site can serve.
# Example: anumatisetu.gov.in,api.anumatisetu.gov.in,localhost,127.0.0.1
ALLOWED_HOSTS=anumatisetu.gov.in,localhost,127.0.0.1

# Comma-separated list of trusted origins for CSRF POST requests
CSRF_TRUSTED_ORIGINS=https://anumatisetu.gov.in,http://localhost:8000

# ------------------------------------------------------------------------------
# Database Configuration: Supabase PostgreSQL (Recommended for Cloud/Production)
# ------------------------------------------------------------------------------
# Provide your Supabase PostgreSQL connection URI.
#
# Option A: Supabase Connection Pooler (Transaction Mode, Port 6543) [RECOMMENDED]
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
#
# Option B: Supabase Direct Connection (Session Mode, Port 5432)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
#
DATABASE_URL=

# Supabase pooler requires server-side cursors disabled (default: True)
DISABLE_SERVER_SIDE_CURSORS=True
DB_SSLMODE=require

# ------------------------------------------------------------------------------
# Legacy / Local Alternative Databases (Ignored if DATABASE_URL is set)
# ------------------------------------------------------------------------------
DB_ENGINE=django.db.backends.mysql
DB_NAME=anumatisetu
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
# Set to True to allow automatic fallback to local SQLite (db.sqlite3) during offline dev
DB_ALLOW_SQLITE_FALLBACK=True

# ------------------------------------------------------------------------------
# Production Security & SSL (Applied when DEBUG=False)
# ------------------------------------------------------------------------------
# Enforce SSL redirection (HTTP -> HTTPS)
SECURE_SSL_REDIRECT=True

# Enforce secure cookies (transmitted only over HTTPS)
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# HTTP Strict Transport Security (HSTS) duration in seconds (default: 1 year = 31536000)
SECURE_HSTS_SECONDS=31536000

# ------------------------------------------------------------------------------
# Groq Cloud AI Engine (LLM-powered Regulatory Assistant)
# ------------------------------------------------------------------------------
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Recommended models: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# Server & Logging Configuration
# ------------------------------------------------------------------------------
PORT=8000
WEB_CONCURRENCY=4
GUNICORN_THREADS=2
LOG_LEVEL=info
CONN_MAX_AGE=600
